<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>io.zapretmac.zapretd</string>
	<key>Program</key>
	<string>/usr/local/libexec/zapretd</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/libexec/zapretd</string>
		<string>--data</string>
		<string>/Library/Application Support/zapret-mac</string>
		<string>--log</string>
		<string>/var/log/zapret-mac.log</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>StandardOutPath</key>
	<string>/var/log/zapret-mac.log</string>
	<key>StandardErrorPath</key>
	<string>/var/log/zapret-mac.err.log</string>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>ThrottleInterval</key>
	<integer>10</integer>
</dict>
</plist>
